{
  "name": "magical-journal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "richmenu": "pnpm --filter @mj/batch richmenu",
    "richmenu:dry": "pnpm --filter @mj/batch richmenu:dry",
    "richmenu:list": "pnpm --filter @mj/batch richmenu:list",
    "personality:static": "pnpm --filter @mj/batch personality:static",
    "personality:static:dry": "pnpm --filter @mj/batch personality:static:dry"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "js-yaml": "^5.2.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.0"
  }
}
